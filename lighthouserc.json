{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "/en/",
        "/fr/",
        "/en/blog/",
        "/fr/blog/",
        "/en/blog/psirt-vs-csirt/",
        "/fr/blog/psirt-vs-csirt/",
        "/en/blog/cyber-resilience-act/",
        "/fr/blog/cyber-resilience-act/",
        "/en/blog/sbom/",
        "/fr/blog/sbom/"
      ],
      "settings": {
        "skipAudits": ["robots-txt"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    }
  }
}
