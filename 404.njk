---
layout: base.njk
lang: en
permalink: 404.html
noindex: true
eleventyComputed:
  title: "{{ translations.en.not_found_title }} | Samy DIFALLAH"
---

{# GitHub Pages serves this single page for every missing URL, so the language is picked in the browser #}
<main class="min-h-screen flex flex-col justify-center items-center px-4 text-center">
    {% for language in ["en", "fr"] %}
    {% set t = translations[language] %}
    <div data-lang="{{ language }}" lang="{{ language }}" class="flex flex-col items-center"{% if language != "en" %} hidden{% endif %}>
        <p class="text-sm uppercase tracking-widest text-stone-400 mb-3">Samy DIFALLAH</p>
        <h1 class="text-7xl sm:text-8xl font-bold mb-8">404</h1>
        <p class="text-2xl font-semibold">{{ t.not_found_title }}</p>
        <p class="max-w-md text-stone-300 leading-relaxed mt-4">{{ t.not_found_message }}</p>
        <a href="/{{ language }}/" class="mt-10 rounded-lg bg-accent hover:bg-accentHover px-5 py-2.5 text-sm font-medium text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950">{{ t.not_found_back }}</a>
    </div>
    {% endfor %}
</main>

<script>
    {
        // A missing page under /fr/ or /en/ tells which site the visitor was on;
        // otherwise, same order as the root page: their own FR/EN choice, then the browser's language
        let lang = location.pathname.match(/^\/(en|fr)\//)?.[1];
        if (!lang) {
            try {
                lang = localStorage.getItem('lang');
            } catch {}
        }
        if (lang !== 'en' && lang !== 'fr') {
            lang = navigator.language.toLowerCase().startsWith('fr') ? 'fr' : 'en';
        }
        if (lang === 'fr') {
            document.querySelector('[data-lang="en"]').hidden = true;
            document.querySelector('[data-lang="fr"]').hidden = false;
            document.documentElement.lang = 'fr';
            document.title = '{{ translations.fr.not_found_title }} | Samy DIFALLAH';
        }
    }
</script>
