<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or translations[lang].title }}</title>
    {% if noindex %}
    <meta name="robots" content="noindex">
    {% else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {% endif %}
{% include "meta.njk" %}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        html {
            scroll-behavior: smooth;
        }

        @media (prefers-reduced-motion: no-preference) {
            main, section {
                animation: fadeIn 0.6s ease-out;
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
        }

        .lang-option {
            color: rgb(163 163 175);
        }

        .lang-option.active {
            background-color: rgb(39 39 42);
            color: rgb(255 255 255);
        }

        .lang-option:hover {
            color: rgb(255 255 255);
        }

        .skills-tab {
            color: rgb(163 163 175);
        }

        .skills-tab[aria-selected="true"] {
            background-color: rgb(39 39 42);
            color: rgb(255 255 255);
        }

        .skills-tab:hover {
            color: rgb(255 255 255);
        }
    </style>
    <link href="/css/styles.css" rel="stylesheet">
</head>
<body class="bg-zinc-950 text-stone-100 font-sans">
    {{ content | safe }}

    <script>
        const scrollPosition = localStorage.getItem('scrollPosition');
        if (scrollPosition) {
            window.scrollTo({
                top: parseInt(scrollPosition),
                behavior: 'instant'
            });
            localStorage.removeItem('scrollPosition');
        }

        // The browser's own restoration on refresh is animated by scroll-behavior: smooth,
        // so restore the position ourselves, instantly
        history.scrollRestoration = 'manual';
        const navigationType = performance.getEntriesByType('navigation')[0]?.type;
        const reloadScrollKey = `reloadScroll:${location.pathname}`;
        try {
            const reloadScroll = sessionStorage.getItem(reloadScrollKey);
            if (!scrollPosition && reloadScroll && (navigationType === 'reload' || navigationType === 'back_forward')) {
                window.scrollTo({
                    top: parseInt(reloadScroll),
                    behavior: 'instant'
                });
            }
        } catch {}

        window.addEventListener('pagehide', function() {
            try {
                sessionStorage.setItem(reloadScrollKey, window.scrollY);
            } catch {}
        });
    </script>
</body>
</html>
