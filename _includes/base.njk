<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or translations[lang].title }}</title>
    {% if noindex %}
    <meta name="robots" content="noindex">
    {% else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {% endif %}
{% include "meta.njk" %}
    <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <style>
        html {
            scroll-behavior: smooth;
        }

        @media (prefers-reduced-motion: no-preference) {
            main, section {
                animation: fadeIn 0.6s ease-out;
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
        }

        .lang-option {
            color: rgb(163 163 175);
        }

        .lang-option.active {
            background-color: rgb(39 39 42);
            color: rgb(255 255 255);
        }

        .lang-option:hover {
            color: rgb(255 255 255);
        }

        .skills-tab {
            color: rgb(163 163 175);
        }

        .skills-tab[aria-selected="true"] {
            background-color: rgb(39 39 42);
            color: rgb(255 255 255);
        }

        .skills-tab:hover {
            color: rgb(255 255 255);
        }
    </style>
    <link href="/css/styles.css" rel="stylesheet">
</head>
<body class="bg-zinc-950 text-stone-100 font-sans">
    {{ content | safe }}

    <script src="/js/scroll-restore.js"></script>
</body>
</html>
