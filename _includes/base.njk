<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ translations[lang].title }}</title>
    <meta name="description" content="{{ translations[lang].pitch }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" hreflang="en" href="{{ site.url }}/">
    <link rel="alternate" hreflang="fr" href="{{ site.url }}/fr/">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">

    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ translations[lang].title }}">
    <meta property="og:description" content="{{ translations[lang].pitch }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:locale" content="{% if lang == 'fr' %}fr_FR{% else %}en_US{% endif %}">
    <meta property="og:locale:alternate" content="{% if lang == 'fr' %}en_US{% else %}fr_FR{% endif %}">
    <meta property="og:image" content="{{ site.url }}/assets/og/og-{{ lang }}.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Samy DIFALLAH, {{ translations[lang].tagline }}">
    <meta name="twitter:card" content="summary_large_image">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        html {
            scroll-behavior: smooth;
        }

        @media (prefers-reduced-motion: no-preference) {
            main, section {
                animation: fadeIn 0.6s ease-out;
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
        }

        .lang-option {
            color: rgb(163 163 175);
        }

        .lang-option.active {
            background-color: rgb(39 39 42);
            color: rgb(255 255 255);
        }

        .lang-option:hover {
            color: rgb(255 255 255);
        }

        .skills-tab {
            color: rgb(163 163 175);
        }

        .skills-tab[aria-selected="true"] {
            background-color: rgb(39 39 42);
            color: rgb(255 255 255);
        }

        .skills-tab:hover {
            color: rgb(255 255 255);
        }
    </style>
    <link href="/css/styles.css" rel="stylesheet">
</head>
<body class="bg-zinc-950 text-stone-100 font-sans">
    {{ content | safe }}

    <script>
        const scrollPosition = localStorage.getItem('scrollPosition');
        if (scrollPosition) {
            window.scrollTo({
                top: parseInt(scrollPosition),
                behavior: 'instant'
            });
            localStorage.removeItem('scrollPosition');
        }

        // The browser's own restoration on refresh is animated by scroll-behavior: smooth,
        // so restore the position ourselves, instantly
        history.scrollRestoration = 'manual';
        const navigationType = performance.getEntriesByType('navigation')[0]?.type;
        const reloadScrollKey = `reloadScroll:${location.pathname}`;
        try {
            const reloadScroll = sessionStorage.getItem(reloadScrollKey);
            if (!scrollPosition && reloadScroll && (navigationType === 'reload' || navigationType === 'back_forward')) {
                window.scrollTo({
                    top: parseInt(reloadScroll),
                    behavior: 'instant'
                });
            }
        } catch {}

        window.addEventListener('pagehide', function() {
            try {
                sessionStorage.setItem(reloadScrollKey, window.scrollY);
            } catch {}
        });
    </script>
</body>
</html>
