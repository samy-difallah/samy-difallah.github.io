    {# Only this site's own files may load: no inline scripts or styles, nothing from elsewhere.
       It applies to what comes after it, so it must stay before any script or stylesheet.
       GitHub Pages can't send headers, so frame-ancestors (which needs one) can't be set.
       connect-src is only for npm run serve: its live reload connects back with a WebSocket. #}
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; {% if eleventy.env.runMode == 'serve' %}connect-src 'self'; {% endif %}base-uri 'none'; form-action 'none'">
    <meta name="description" content="{{ description or translations[lang].pitch }}">
    {% if not noindex %}
    <link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url | otherLangUrl('en') }}">
    <link rel="alternate" hreflang="fr" href="{{ site.url }}{{ page.url | otherLangUrl('fr') }}">
    {% if page.url in ["/", "/en/", "/fr/"] %}
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
    {% endif %}
    {% endif %}
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">

    <meta property="og:type" content="{% if article %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ title or translations[lang].title }}">
    <meta property="og:description" content="{{ description or translations[lang].pitch }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:locale" content="{% if lang == 'fr' %}fr_FR{% else %}en_US{% endif %}">
    <meta property="og:locale:alternate" content="{% if lang == 'fr' %}en_US{% else %}fr_FR{% endif %}">
    <meta property="og:image" content="{{ site.url }}/assets/og/og-{{ lang }}.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Samy DIFALLAH, {{ translations[lang].tagline }}">
    <meta name="twitter:card" content="summary_large_image">
