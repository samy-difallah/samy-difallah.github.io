<section id="projects" class="scroll-mt-20 pb-20 max-w-4xl mx-auto px-4">
    <h2 class="text-4xl font-semibold text-center mb-16">{{ translations[lang].projects_title }}</h2>
    {# Flex rather than grid, so a lone project stays centred; two per row from sm up #}
    <ul class="flex flex-wrap justify-center gap-6">
        {% for project in translations[lang].projects %}
        <li class="w-full sm:w-[calc(50%-0.75rem)] rounded-lg border border-zinc-800 bg-zinc-900/50 px-6 py-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 pb-4 border-b border-zinc-800">
                <h3 class="text-xl font-semibold">{{ project.name }}</h3>
                <span class="flex items-center gap-4 text-sm">
                    {% for link in [["GitHub", project.github], ["PyPI", project.pypi]] %}
                    {% if link[1] %}
                    <a href="{{ link[1] }}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">
                        {{ link[0] }}
                        {% icon "arrow-up-right-from-square", "text-xs" %}
                    </a>
                    {% endif %}
                    {% endfor %}
                </span>
            </div>
            <p class="pt-4 text-stone-300 leading-relaxed">{{ project.description }}</p>
            {% if project.tags %}
            <ul class="mt-4 flex flex-wrap gap-2">
                {% for tag in project.tags %}
                <li class="rounded-md border border-zinc-700/50 bg-zinc-800/60 px-2.5 py-0.5 text-xs text-stone-300">{{ tag }}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </li>
        {% endfor %}
    </ul>
</section>
