<nav class="fixed top-0 left-0 right-0 px-4 sm:px-8 backdrop-blur-md shadow-xs z-50">
    <div class="px-4 sm:px-8">
        <div class="relative flex justify-between items-center h-16">
            <div class="text-2xl text-stone-100">
                <a href="/{{ lang }}/" class="font-bold hover:opacity-80">Samy DIFALLAH</a>
            </div>
            {# Centred on the bar itself, since the name and the switcher on each side have different widths.
               Hidden on small screens, where those two already fill the bar #}
            <ul aria-label="{{ translations[lang].nav_label }}" class="hidden lg:flex absolute left-1/2 -translate-x-1/2 items-center gap-8 text-sm font-medium">
                {% for section in ["experience", "skills", "education"] %}
                <li><a href="#{{ section }}" class="section-link text-stone-300 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{{ translations[lang]["nav_" + section] }}</a></li>
                {% endfor %}
            </ul>
            <div class="lang-switcher">
                <div role="group" aria-label="{{ translations[lang].language_switcher }}" class="relative flex items-center bg-stone-800/50 rounded-lg px-1 py-1 border border-stone-700/50 hover:border-stone-600/50 transition-all duration-300">
                    <a href="/fr/" data-lang="fr" hreflang="fr" lang="fr" aria-label="Français"{% if lang == 'fr' %} aria-current="page"{% endif %} class="lang-option{% if lang == 'fr' %} active{% endif %} px-3 py-1 text-sm font-medium rounded-md transition-all duration-300 cursor-pointer">FR</a>
                    <span class="w-px h-4 bg-stone-600/50 mx-1" aria-hidden="true"></span>
                    <a href="/en/" data-lang="en" hreflang="en" lang="en" aria-label="English"{% if lang == 'en' %} aria-current="page"{% endif %} class="lang-option{% if lang == 'en' %} active{% endif %} px-3 py-1 text-sm font-medium rounded-md transition-all duration-300 cursor-pointer">EN</a>
                </div>
            </div>
        </div>
    </div>
</nav>

<script>
    (function() {
        const currentLang = '{{ lang }}';
        const langLinks = document.querySelectorAll('.lang-option');

        langLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                // Remembered so the root page sends the visitor to this language next time
                try {
                    localStorage.setItem('lang', this.dataset.lang);
                } catch {}
                if (this.dataset.lang === currentLang) {
                    e.preventDefault();
                } else {
                    localStorage.setItem('scrollPosition', window.scrollY);
                }
            });
        });

        // Scroll to the section without adding #section to the URL
        document.querySelectorAll('.section-link').forEach(link => {
            link.addEventListener('click', function(e) {
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView();
                }
            });
        });
    })();
</script>
