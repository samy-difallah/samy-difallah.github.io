<section id="education" class="scroll-mt-20 pb-20 max-w-3xl mx-auto px-4">
    <h2 class="text-4xl font-semibold text-center mb-16">{{ translations[lang].education_title }}</h2>
    <ol class="relative ml-2.5 border-l-2 border-stone-700 space-y-12">
        {% for school in translations[lang].education %}
        <li class="relative pl-6 sm:pl-8">
            <span class="absolute -left-[11px] top-5w-5 h-5 rounded-full bg-white border-2 border-zinc-950" aria-hidden="true"></span>
            <div class="grid grid-cols-[auto_1fr] gap-x-4">
                <span class="col-start-1 row-start-1 row-span-3 flex items-center justify-center h-10 w-10 mt-1 overflow-hidden">
                    {% if school.logo %}
                    <img src="{{ school.logo }}" alt="" width="40" height="40" class="max-h-full max-w-full object-contain">
                    {% endif %}
                </span>
                <h3 class="col-start-2 row-start-1 text-xl font-semibold">{{ school.degree }}</h3>
                <span class="col-start-2 row-start-2 text-stone-300">{{ school.school }}</span>
                <span class="col-start-2 row-start-3 flex flex-wrap items-center gap-x-4 gap-y-1 mt-1 text-sm">
                    <time class="text-stone-400">{{ school.period }}</time>
                    <span class="flex items-center gap-2 text-stone-500">
                        {% icon "location-dot", "text-xs" %}
                        {{ school.location }}
                    </span>
                </span>
            </div>
        </li>
        {% endfor %}
    </ol>
</section>
